// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_POSTGRES_URL_NON_POOLING")
}

// Core User Model - Simplified for MVP
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  role              UserRole  @default(CUSTOMER)
  emailVerified     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  bakerProfile      BakerProfile?
  inquiries         Inquiry[]
}

// Baker Profile - Simplified for MVP
model BakerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  businessName        String
  description         String   @db.Text
  location            String
  deliveryRadius      Int      // in miles
  featured            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cakeListings       CakeListing[]
  inquiries          Inquiry[]
}

// Cake Listings - Simplified for MVP
model CakeListing {
  id              String   @id @default(cuid())
  bakerId         String
  title           String
  description     String   @db.Text
  price           Float
  category        String
  images          String[] // Array of image URLs
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  baker           BakerProfile @relation(fields: [bakerId], references: [id], onDelete: Cascade)
  categoryRelation Category     @relation(fields: [category], references: [id])
}

// Categories
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Relations
  cakeListings CakeListing[]
}

// Customer Inquiries - Simple contact system for MVP
model Inquiry {
  id              String   @id @default(cuid())
  customerId      String
  bakerProfileId  String
  customerName    String
  customerEmail   String
  customerPhone   String?
  message         String   @db.Text
  referralSource  String?  // Track which influencer sent this inquiry
  status          InquiryStatus @default(NEW)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  customer        User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  baker           BakerProfile @relation(fields: [bakerProfileId], references: [id], onDelete: Cascade)
}

// Enums - Simplified for MVP
enum UserRole {
  CUSTOMER
  BAKER
  ADMIN
}

enum InquiryStatus {
  NEW
  CONTACTED
  COMPLETED
}